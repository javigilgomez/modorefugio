---
import { getCollection } from 'astro:content';
import Print from '../../../../layouts/Print.astro';
import PrintHeader from '../../../../components/PrintHeader.astro';
import { TELEFONOS } from '../../../../data/emergencias';
import { SITE } from '../../../../data/site';
import { stepText, fmtDate } from '../../../../lib/util';
import { findRecs } from '../../../../data/recomendados';
export async function getStaticPaths() {
  return (await getCollection('playbooks')).map((pb) => ({ params: { slug: pb.id }, props: { pb } }));
}
const { pb } = Astro.props;
const d = pb.data;
const url = `${SITE.url}/playbook/${pb.id}/`;
---
<Print title={d.title}>
  <PrintHeader kicker="The Playbook" title={d.nombre} subtitle={d.subtitle ?? d.resumen} url={url} />
  {d.escena && <div class="scene"><span class="scene__s">{d.escena.hora} · {d.escena.lugar}</span> {d.escena.texto} <strong>{d.escena.gancho}</strong></div>}
  <section class="first">
    <h2>Lo primero</h2>
    <ol>{d.primero.map((x) => <li set:html={x} />)}</ol>
  </section>
  {d.fases.map((f, i) => (
    <section class="phase">
      <h2><span class="n">{i + 1}</span> {f.titulo} <small>{f.cuando}</small></h2>
      <ul>{f.pasos.map((s) => { const st = stepText(s); return <li class:list={{ crit: st.critico }}><span class="box" /> <span><span set:html={st.t} />{st.d && <em set:html={' — ' + st.d} />}</span></li>; })}</ul>
    </section>
  ))}
  <div class="two">
    <section class="dont">
      <h2>NO hagas</h2>
      <ul>{d.noHagas.map((x) => <li set:html={x} />)}</ul>
    </section>
    <section class="tel">
      <h2>Teléfonos</h2>
      <ul>{TELEFONOS.filter((t) => t.pais !== 'Unión Europea').map((t) => <li><span>{t.pais}</span><strong>{t.principal}</strong></li>)}</ul>
      <p class="mine">Mis contactos: ______________________<br />Punto de encuentro: ________________</p>
    </section>
  </div>
  <section class="kit">
    <h2>Qué tener a mano</h2>
    <div class="kit__g">
      <div>
        <h3>Básico</h3>
        <ul>{d.prepara.basico.map((x) => <li><span class="box" /><span><span set:html={x} />{findRecs(x).length > 0 && <em class="rec"> Recomendado</em>}</span></li>)}</ul>
      </div>
      <div>
        <h3>Avanzado</h3>
        <ul>{d.prepara.avanzado.map((x) => <li><span class="box" /><span><span set:html={x} />{findRecs(x).length > 0 && <em class="rec"> Recomendado</em>}</span></li>)}</ul>
      </div>
    </div>
  </section>
  {d.despues && (<section class="phase after"><h2>Después</h2><ul>{d.despues.map((x) => <li><span class="box" /> <span set:html={x} /></li>)}</ul></section>)}
  <footer class="pf">
    <span>modorefugio.com/playbook/{pb.id}/ · Revisado el {fmtDate(d.actualizado)}</span>
    <span>Información divulgativa. Sigue siempre las indicaciones de Protección Civil y del 112.</span>
  </footer>
</Print>
<style>
  h2{font-size:12.5pt;margin-bottom:2mm;display:flex;align-items:center;gap:2mm}
  h2 small{font:700 7.5pt/1 var(--font-body);letter-spacing:.1em;text-transform:uppercase;color:#C2410C;margin-left:auto}
  .n{display:inline-grid;place-items:center;width:6mm;height:6mm;border-radius:1.6mm;background:#14352F;color:#fff;font:700 9pt/1 var(--font-body)}
  .first{background:#FDEEE3;border-radius:3mm;padding:3.5mm 4.5mm;margin-bottom:4mm;break-inside:avoid}
  .first h2{color:#9A3309}
  .first ol{margin:0;padding-left:5mm;columns:2;column-gap:7mm}
  .first li{font-weight:600;margin-bottom:1.2mm;break-inside:avoid}
  .phase{margin-bottom:4mm}
  .phase h2{break-after:avoid}
  .phase li{display:flex;gap:2.4mm;align-items:flex-start;padding:1.1mm 0;border-bottom:.3mm solid #E5DDCB;break-inside:avoid}
  .phase li em{color:#5C5A50;font-style:normal;font-size:9pt}
  .box{flex:none;width:3.6mm;height:3.6mm;border:.45mm solid #14352F;border-radius:.8mm;margin-top:.6mm}
  .crit{font-weight:650}
  .crit .box{border-color:#C2410C;background:#FDEEE3}
  .two{display:grid;grid-template-columns:1.25fr 1fr;gap:5mm;margin:4mm 0;break-inside:avoid}
  .dont{background:#FBE4E1;border-radius:3mm;padding:3.5mm 4.5mm;color:#8F1D14}
  .dont h2{color:#8F1D14}
  .dont li{margin-bottom:1.2mm;padding-left:4mm;position:relative;font-size:9.3pt}
  .dont li::before{content:'✕';position:absolute;left:0;font-weight:800}
  .tel{border:.4mm solid #CFC5AE;border-radius:3mm;padding:3.5mm 4.5mm}
  .tel li{display:flex;justify-content:space-between;font-size:9pt;border-bottom:.2mm dotted #CFC5AE;padding:.6mm 0}
  .mine{font-size:8.5pt;margin:2.5mm 0 0;line-height:2}
  .pf{display:flex;justify-content:space-between;gap:4mm;border-top:.4mm solid #E5DDCB;margin-top:5mm;padding-top:2mm;font-size:7pt;color:#7D7767}
  .scene{background:#14352F;color:#F4EFE3;border-radius:2.5mm;padding:3mm 4.5mm;margin:0 0 4mm;font:9pt/1.45 var(--font-scene,var(--font-heading))}
  .scene__s{font:700 7pt/1 var(--font-scene,ui-monospace),ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:#F5C451;font-style:normal;margin-right:1.5mm}
  .scene strong{color:#fff;font-style:normal}
  .kit{margin-top:4mm;break-inside:avoid}
  .kit__g{display:grid;grid-template-columns:1fr 1fr;gap:4mm}
  .kit h3{font-size:10pt;margin:0 0 1.5mm}
  .kit li{display:flex;gap:2.2mm;padding:.8mm 0;font-size:9pt;border-bottom:.25mm solid #E5DDCB}
  .kit .box{flex:none;width:3.3mm;height:3.3mm;border:.4mm solid #14352F;border-radius:.7mm;margin-top:.6mm}
  .rec{font-style:normal;font-weight:700;font-size:7.5pt;letter-spacing:.06em;text-transform:uppercase;color:#C2410C;margin-left:1.5mm}
</style>
