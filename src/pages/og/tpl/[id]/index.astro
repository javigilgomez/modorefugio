---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { photo } from '../../../../data/photos';
import { CATEGORIAS } from '../../../../data/categorias';
import '../../../../styles/tokens.css';
export async function getStaticPaths() {
  const pbs = await getCollection('playbooks');
  return [
    { params: { id: 'default' }, props: { kicker: 'La guía de preparación en español', title: 'Prepárate sin miedo. Actúa con un plan.', ph: 'hero', pb: false } },
    { params: { id: 'playbook' }, props: { kicker: 'The Playbook', title: 'Qué hacer cuando pasa', ph: 'incendio', pb: true } },
    ...pbs.map((p) => ({ params: { id: `playbook-${p.id}` }, props: { kicker: 'The Playbook', title: p.data.nombre, sub: p.data.resumen, ph: p.data.photo, pb: true } })),
    ...CATEGORIAS.map((c) => ({ params: { id: `preparate-${c.id}` }, props: { kicker: 'Prepárate · Básico y avanzado', title: c.nombre, sub: c.claim, ph: c.photo, pb: false } })),
  ];
}
const { kicker, title, sub, ph, pb } = Astro.props as { kicker: string; title: string; sub?: string; ph: string; pb: boolean };
const img = await getImage({ src: photo(ph).src, width: 1200, format: 'jpeg', quality: 80 });
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>OG {title}</title>
<style is:global>
  @font-face{font-family:'Fraunces';font-weight:100 900;src:url('/fonts/Fraunces-Variable.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-weight:100 900;src:url('/fonts/Inter-Variable.woff2') format('woff2')}
  html,body{margin:0;width:1200px;height:630px;overflow:hidden}
  .og{position:relative;width:1200px;height:630px;color:#fff;font-family:var(--font-body);display:flex;flex-direction:column;justify-content:space-between;padding:56px 64px;box-sizing:border-box;background:#0F2A25 center/cover no-repeat}
  .og::before{content:'';position:absolute;inset:0;background:linear-gradient(100deg,rgba(9,28,24,.96) 0%,rgba(9,28,24,.82) 50%,rgba(9,28,24,.35) 100%)}
  .og.pb::before{background:linear-gradient(100deg,rgba(40,14,4,.96) 0%,rgba(60,20,6,.8) 50%,rgba(60,20,6,.3) 100%)}
  .og > *{position:relative}
  .k{display:inline-block;font-weight:800;letter-spacing:.14em;text-transform:uppercase;font-size:22px;padding:10px 16px;border-radius:8px;background:#E3A008;color:#14352F;align-self:flex-start}
  .pb .k{background:#C2410C;color:#fff}
  h1{font-family:var(--font-heading);font-size:92px;line-height:1;margin:24px 0 16px;max-width:900px;letter-spacing:-.02em}
  p{font-size:28px;line-height:1.35;max-width:820px;margin:0;opacity:.9}
  .logo{height:56px}
</style></head>
<body><div class:list={['og', { pb }]} style={`background-image:url(${img.src})`}>
  <img class="logo" src="/brand/logo-horizontal-dark.svg" alt="" />
  <div><span class="k">{kicker}</span><h1>{title}</h1>{sub && <p>{sub}</p>}</div>
</div></body></html>
