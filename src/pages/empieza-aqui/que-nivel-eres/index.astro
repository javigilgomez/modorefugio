---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
const crumbs = [{ name: 'Empieza aquí', href: '/empieza-aqui/' }, { name: '¿Qué nivel eres?', href: '/empieza-aqui/que-nivel-eres/' }];
const Q = [
  { q: '¿Cuánta agua embotellada tienes ahora mismo en casa?', link: '/preparate/agua/', o: ['Casi nada', 'Para 1–2 días', 'Para 3 días o más (3 L por persona y día)', 'Para una semana o más y sé potabilizar'] },
  { q: 'Si mañana se va la luz 24 horas, ¿cómo te alumbras?', link: '/preparate/energia-y-luz/', o: ['Con la linterna del móvil', 'Tengo alguna linterna, no sé si con pilas', 'Linternas LED con pilas de repuesto', 'Frontales, lámparas y una estación de energía o placa solar'] },
  { q: '¿Cómo te informarías sin internet ni cobertura?', link: '/preparate/comunicaciones/', o: ['No lo sé', 'Con la radio del coche', 'Tengo radio a pilas o de dinamo', 'Radio + plan de contacto familiar escrito + walkies'] },
  { q: '¿Cuántos días podrías comer sin ir a la compra ni usar la nevera?', link: '/preparate/alimentos/', o: ['Ninguno', '1–2 días', '3 días o más', 'Dos semanas o más, con despensa rotada'] },
  { q: '¿Y para cocinar o calentar comida sin luz?', link: '/preparate/alimentos/avanzado/', o: ['No podría', 'Solo comida fría', 'Tengo un hornillo de camping (y lo usaría con ventilación)', 'Hornillo + combustible para días + sé hacerlo con seguridad'] },
  { q: '¿Tu botiquín y tu medicación?', link: '/preparate/salud-y-botiquin/', o: ['No tengo botiquín', 'Algo hay, sin revisar', 'Botiquín completo y medicación para una semana', 'Lo anterior + curso de primeros auxilios'] },
  { q: '¿Tienes efectivo y copias de documentos?', link: '/preparate/documentos-y-dinero/', o: ['No', 'Algo de efectivo', 'Efectivo en billetes pequeños + copias en bolsa estanca', 'Lo anterior + copia cifrada fuera de casa'] },
  { q: 'Si tuvieras que salir de casa en 10 minutos…', link: '/preparate/mochila-72h/', o: ['No sabría qué coger', 'Tengo una idea', 'Tengo una mochila preparada', 'Mochila por persona + ruta de evacuación pensada'] },
  { q: '¿Tenéis un plan familiar (punto de encuentro, quién recoge a quién)?', link: '/preparate/familia/', o: ['No', 'Lo hemos hablado por encima', 'Sí, y los teléfonos están en papel', 'Sí, y lo hemos practicado'] },
  { q: '¿Sabes qué hacer en los primeros minutos de un apagón, una DANA o un terremoto?', link: '/playbook/', o: ['No', 'Más o menos', 'Sí, he leído los playbooks', 'Sí, y los tengo impresos con el kit'] },
];
---
<Base title="Test: ¿qué nivel de preparación tienes?" description="10 preguntas para saber cómo de preparado está tu hogar ante un apagón, una DANA o cualquier emergencia, y qué hacer después." crumbs={crumbs}>
  <section class="container container--narrow section--tight">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow"><Icon name="sparkles" size={16} /> Test · 2 minutos</p>
    <h1>¿Qué nivel eres?</h1>
    <p class="lead">Responde con sinceridad. Nadie más verá tus respuestas: el test funciona solo en tu navegador.</p>
    <form id="quiz" class="quiz">
      {Q.map((x, i) => (
        <fieldset class="q" data-link={x.link}>
          <legend><span>{i + 1}/{Q.length}</span> {x.q}</legend>
          {x.o.map((o, j) => (
            <label><input type="radio" name={`q${i}`} value={j} required /><span>{o}</span></label>
          ))}
        </fieldset>
      ))}
      <button class="btn btn--accent btn--lg" type="submit">Ver mi resultado</button>
    </form>
    <div id="result" class="result" hidden aria-live="polite">
      <p class="eyebrow">Tu resultado</p>
      <h2 id="r-title"></h2>
      <div class="meter"><span id="r-bar"></span></div>
      <p id="r-text" class="lead"></p>
      <h3>Por dónde seguir</h3>
      <ul id="r-links" class="rlinks"></ul>
      <p><button class="btn btn--ghost" type="button" id="again">Repetir el test</button></p>
    </div>
  </section>
</Base>
<script>
  const levels = [
    { max: 0.25, t: 'Nivel 0 · Sin red', x: 'Ahora mismo, un apagón de un día te pondría en apuros. La buena noticia: con una tarde y poco dinero subes de nivel.' },
    { max: 0.5, t: 'Nivel 1 · En marcha', x: 'Tienes cosas sueltas, pero te faltan piezas clave. Completa el kit básico y tendrás 72 horas cubiertas.' },
    { max: 0.75, t: 'Nivel 2 · Básico completo', x: 'Estás mejor que la mayoría: aguantarías 72 horas. El siguiente paso es el nivel avanzado en las categorías más flojas.' },
    { max: 1.01, t: 'Nivel 3 · Avanzado', x: 'Tu casa está preparada de verdad. Revisa cada 6 meses y ayuda a tu familia o vecinos a llegar al básico.' },
  ];
  const form = document.getElementById('quiz') as HTMLFormElement;
  const res = document.getElementById('result')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const sets = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset')];
    let sum = 0; const weak: { q: string; link: string; v: number }[] = [];
    sets.forEach((fs) => {
      const v = Number((fs.querySelector('input:checked') as HTMLInputElement).value);
      sum += v;
      if (v < 2) weak.push({ q: fs.querySelector('legend')!.textContent!.replace(/^\d+\/\d+\s*/, ''), link: fs.dataset.link!, v });
    });
    const score = sum / (sets.length * 3);
    const L = levels.find((l) => score < l.max)!;
    document.getElementById('r-title')!.textContent = L.t;
    document.getElementById('r-text')!.textContent = L.x;
    (document.getElementById('r-bar') as HTMLElement).style.width = Math.round(score * 100) + '%';
    const ul = document.getElementById('r-links')!; ul.innerHTML = '';
    const items = weak.sort((a, b) => a.v - b.v).slice(0, 4);
    if (!items.length) items.push({ q: 'Explora el nivel avanzado de cada categoría', link: '/preparate/', v: 3 });
    items.forEach((w) => { const li = document.createElement('li'); const a = document.createElement('a'); a.href = w.link; a.textContent = w.q; li.append(a); ul.append(li); });
    const li = document.createElement('li'); const a = document.createElement('a'); a.href = '/empieza-aqui/kit-basico-en-una-tarde/'; a.textContent = 'Plan: tu kit básico en una tarde'; li.append(a); ul.append(li);
    form.hidden = true; res.hidden = false; res.scrollIntoView({ behavior: 'smooth' });
  });
  document.getElementById('again')!.addEventListener('click', () => { form.reset(); form.hidden = false; res.hidden = true; form.scrollIntoView(); });
</script>
<style>
  .quiz{display:grid;gap:var(--space-5);margin-top:var(--space-8)}
  .q{border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:var(--space-5);background:var(--color-surface);margin:0}
  .q legend{font:600 var(--size-lg)/1.3 var(--font-heading);color:var(--color-heading);padding:0 .3em}
  .q legend span{font:700 var(--size-xs)/1 var(--font-body);color:var(--color-secondary);margin-right:.3em}
  .q label{display:flex;gap:.7em;align-items:flex-start;padding:.65em .8em;border-radius:var(--radius-sm);cursor:pointer;margin-top:var(--space-1)}
  .q label:hover{background:var(--color-bg-subtle)}
  .q input{margin-top:.25em;accent-color:var(--color-primary);width:1.1em;height:1.1em}
  .q label:has(input:checked){background:var(--color-secondary-soft);font-weight:600}
  .result{margin-top:var(--space-8);padding:var(--space-8);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-md);border-top:6px solid var(--color-accent)}
  .result h2{font-size:var(--size-3xl);margin:0 0 var(--space-4)}
  .meter{height:12px;border-radius:99px;background:var(--color-bg-subtle);overflow:hidden}
  .meter span{display:block;height:100%;background:linear-gradient(90deg,var(--signal-500),var(--amber-400),var(--sage-500));transition:width .8s var(--motion-ease)}
  .rlinks{display:grid;gap:var(--space-2);padding-left:1.2em}
  .rlinks a{font-weight:600}
</style>
