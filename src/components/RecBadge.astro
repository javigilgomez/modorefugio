---
import type { Rec } from '../data/recomendados';
import { AFFILIATE, amazonSearchUrl } from '../data/site';
interface Props { rec: Rec }
const { rec } = Astro.props;
---
<span class="rec">
  <span class="rec__pill">Recomendado</span>
  {rec.page && <a class="rec__a" href={rec.page}>Ver ficha</a>}
  {AFFILIATE.enabled && (
    <a class="rec__a rec__amz" href={amazonSearchUrl(rec.query)} rel={AFFILIATE.rel} target="_blank">Ver en Amazon</a>
  )}
</span>
<style>
  .rec{display:inline-flex;flex-wrap:wrap;align-items:center;gap:.35em .55em;margin:.25em 0 0;font-size:var(--size-xs)}
  .rec__pill{display:inline-block;padding:.12em .55em;border-radius:var(--radius-pill);background:var(--color-playbook-bg);color:var(--color-playbook-text);font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:10px;line-height:1.4}
  .rec__a{color:var(--color-text-muted);text-decoration:underline;text-underline-offset:2px;font-weight:600}
  .rec__a:hover{color:var(--color-link)}
</style>
