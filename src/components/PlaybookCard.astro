---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { pb: CollectionEntry<'playbooks'>; size?: 'lg' | 'md' | 'sm'; href?: string }
const { pb, size = 'md', href } = Astro.props;
const d = pb.data;
---
<a href={href ?? `/playbook/${pb.id}/`} class:list={['pbcard', `pbcard--${size}`]}>
  <Photo k={d.photo} widths={[400, 700]} sizes="(min-width:1000px) 33vw, 100vw" class="pbcard__img" />
  <div class="pbcard__body">
    <span class="pbcard__icon"><Icon name={d.icon} size={size === 'sm' ? 18 : 22} /></span>
    <h3>{d.nombre}</h3>
    {size !== 'sm' && <p>{d.resumen}</p>}
    <span class="pbcard__go">Abrir playbook <Icon name="arrow-right" size={16} /></span>
  </div>
</a>
<style>
  .pbcard{position:relative;display:flex;align-items:flex-end;min-height:260px;border-radius:var(--radius-lg);overflow:hidden;text-decoration:none;color:#fff;isolation:isolate;box-shadow:var(--shadow-md);transition:transform var(--motion-base) var(--motion-ease),box-shadow var(--motion-base)}
  .pbcard--lg{min-height:360px}
  .pbcard--sm{min-height:170px}
  .pbcard:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);color:#fff}
  .pbcard :global(.pbcard__img){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform var(--motion-slow) var(--motion-ease)}
  .pbcard:hover :global(.pbcard__img){transform:scale(1.04)}
  .pbcard::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(40,12,2,.05) 20%,rgba(40,12,2,.88) 100%)}
  .pbcard__body{padding:var(--space-5) var(--space-6)}
  .pbcard__icon{display:inline-grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--color-playbook);margin-bottom:var(--space-3)}
  .pbcard--sm .pbcard__icon{width:32px;height:32px;border-radius:9px}
  .pbcard h3{color:#fff;margin:0 0 .25em;font-size:var(--size-xl)}
  .pbcard--sm h3{font-size:var(--size-lg)}
  .pbcard p{font-size:var(--size-sm);color:rgba(255,255,255,.85);margin:0 0 .75em}
  .pbcard__go{display:inline-flex;gap:.4em;align-items:center;font-size:var(--size-xs);font-weight:700;letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--signal-200)}
  .pbcard--sm .pbcard__go{display:none}
</style>
