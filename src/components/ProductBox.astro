---
// TODO: cuando la cuenta de Amazon Afiliados tenga 3 ventas y acceso a PA-API o SiteStripe,
// sustituir la foto genérica del tipo de producto por la imagen oficial del modelo (Amazon/fabricante).
// No copiar ni hacer hotlink de fotos de Amazon hasta entonces (política de Amazon).
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { prodById, tipoPhoto } from '../data/products';
import { AFFILIATE, amazonSearchUrl, amazonAsinUrl } from '../data/site';
interface Props { id: string; compact?: boolean; rank?: number }
const { id, compact = false, rank } = Astro.props;
const p = prodById(id);
const href = p.asin ? amazonAsinUrl(p.asin) : amazonSearchUrl(p.amazonQuery);
const ph = tipoPhoto(p.tipo);
---
<article class:list={['pbox', { 'pbox--compact': compact }]} id={`p-${p.id}`}>
  <div class="pbox__media">
    <Photo k={ph.key} alt={ph.alt} widths={[320, 480, 720]} sizes={compact ? '(min-width:1000px) 30vw, 100vw' : '(min-width:800px) 240px, 100vw'} ratio="4/3" />
  </div>
  <div class="pbox__body">
    <div class="pbox__head">
      {rank && <span class="pbox__rank">{rank}</span>}
      <div>
        {p.destacado && <span class="pbox__tag"><Icon name="award" size={14} /> {p.destacado}</span>}
        <h3>{p.nombre}</h3>
        <p class="pbox__type">{p.tipo} · <span class={`badge ${p.nivel === 'basico' ? 'badge--basic' : 'badge--advanced'}`}>{p.nivel === 'basico' ? 'Básico' : 'Avanzado'}</span></p>
      </div>
    </div>
    <p>{p.resumen}</p>
    {!compact && (
      <>
        <dl class="pbox__specs">{p.specs.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}</dl>
        <div class="pbox__pc">
          <ul class="pros">{p.pros.map((x) => <li><Icon name="check" size={16} /> {x}</li>)}</ul>
          <ul class="cons">{p.contras.map((x) => <li><Icon name="x" size={16} /> {x}</li>)}</ul>
        </div>
        <p class="pbox__ideal"><strong>Ideal para:</strong> {p.idealPara}</p>
      </>
    )}
    <div class="pbox__cta">
      {AFFILIATE.enabled && <a class="btn btn--accent" href={href} rel={AFFILIATE.rel} target="_blank" data-aff={p.id}><Icon name="shopping-cart" size={18} /> Ver precio en Amazon</a>}
      <a class="pbox__src xs" href={p.fuente} rel="noopener nofollow" target="_blank">Especificaciones del fabricante ↗</a>
    </div>
  </div>
</article>
<style>
  .pbox{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:0;overflow:hidden;box-shadow:var(--shadow-sm);margin:var(--space-6) 0;display:grid;grid-template-columns:minmax(0,220px) 1fr;align-items:stretch}
  .pbox--compact{margin:0;height:100%;display:flex;flex-direction:column;grid-template-columns:1fr}
  .pbox--compact .pbox__cta{margin-top:auto}
  .pbox__media{background:var(--color-bg-subtle);min-height:0}
  .pbox__media :global(img){width:100%;height:100%;object-fit:cover;display:block}
  .pbox__body{padding:var(--space-6);display:flex;flex-direction:column}
  .pbox__head{display:flex;gap:var(--space-4);align-items:flex-start}
  .pbox__rank{flex:none;width:44px;height:44px;border-radius:50%;background:var(--color-primary);color:var(--color-on-primary);display:grid;place-items:center;font:700 var(--size-lg)/1 var(--font-heading)}
  .pbox h3{margin:.15em 0 .2em;font-size:var(--size-xl)}
  .pbox__tag{display:inline-flex;gap:.35em;align-items:center;font-size:var(--size-xs);font-weight:700;color:var(--color-accent);background:var(--color-accent-soft);padding:.2em .6em;border-radius:var(--radius-pill)}
  .pbox__type{font-size:var(--size-sm);color:var(--color-text-muted);margin:0 0 .75em}
  .pbox__specs{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:var(--space-2);margin:var(--space-4) 0}
  .pbox__specs div{background:var(--color-bg-subtle);border-radius:var(--radius-sm);padding:.55em .75em}
  .pbox__specs dt{font-size:var(--size-xs);color:var(--color-text-muted)}
  .pbox__specs dd{margin:0;font-weight:600;color:var(--color-heading);font-size:var(--size-sm)}
  .pbox__pc{display:grid;gap:var(--space-4);grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin:var(--space-4) 0}
  .pbox__pc ul{list-style:none;padding:0;margin:0;display:grid;gap:.4em;font-size:var(--size-sm)}
  .pbox__pc li{display:flex;gap:.5em;align-items:flex-start}
  .pros :global(.icon){color:var(--color-success);margin-top:3px}
  .cons :global(.icon){color:var(--color-danger);margin-top:3px}
  .pbox__ideal{font-size:var(--size-sm);background:var(--color-secondary-soft);padding:.6em .9em;border-radius:var(--radius-sm)}
  .pbox__cta{display:flex;gap:var(--space-4);align-items:center;flex-wrap:wrap;margin-top:var(--space-4)}
  .pbox__src{color:var(--color-text-muted)}
  @media (max-width:700px){.pbox{grid-template-columns:1fr}}
</style>
