---
import type { Crumb } from '../layouts/Base.astro';
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Migas de pan">
  <ol>
    <li><a href="/">Inicio</a></li>
    {items.map((c, i) => <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
  </ol>
</nav>
