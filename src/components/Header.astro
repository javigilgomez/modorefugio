---
import Icon from './Icon.astro';
import { CATEGORIAS } from '../data/categorias';
const path = Astro.url.pathname;
const is = (p: string) => path.startsWith(p);
const CALC = '/calculadora/';
const mas = [
  { href: '/empieza-aqui/', label: 'Empieza aquí', icon: 'compass' },
  { href: '/imprescindibles/', label: 'Imprescindibles', icon: 'package-check' },
  { href: '/herramientas/', label: 'Herramientas', icon: 'wrench' },
  { href: '/descargas/', label: 'Descargas (PDF)', icon: 'download' },
  { href: '/telefonos-de-emergencia/', label: 'Teléfonos de emergencia', icon: 'phone' },
];
const masActive = mas.some((m) => is(m.href));
---
<header class="site">
  <div class="container container--wide bar">
    <a href="/" class="logo" aria-label="Modo Refugio, inicio">
      <img src="/brand/logo-horizontal-simple.svg" alt="Modo Refugio" width="193" height="40" class="logo-light" />
      <img src="/brand/logo-horizontal-simple-dark.svg" alt="" width="193" height="40" class="logo-dark" aria-hidden="true" />
    </a>
    <nav class="nav nav--desktop" aria-label="Principal">
      <div class="nav__drop">
        <a href="/preparate/" aria-current={is('/preparate') ? 'page' : undefined}>Prepárate <Icon name="chevron-down" size={16} /></a>
        <div class="mega">
          <div class="mega__grid">
            {CATEGORIAS.map((c) => (
              <a href={`/preparate/${c.id}/`}><Icon name={c.icon} size={18} /> {c.nombre}</a>
            ))}
          </div>
          <div class="mega__foot">
            <a href="/preparate/#por-riesgo">Prepárate por riesgo →</a>
            <span><span class="badge badge--basic">Básico</span> <span class="badge badge--advanced">Avanzado</span> <a class="badge badge--prepper" href="/preparate/prepper/">Prepper</a></span>
          </div>
        </div>
      </div>
      <a href="/playbook/" class="nav__pb" aria-current={is('/playbook') ? 'page' : undefined}><Icon name="siren" size={18} /> The Playbook</a>
      <a href={CALC} class="nav__calc" aria-current={is('/calculadora') ? 'page' : undefined}><Icon name="calculator" size={18} /> Calculadora</a>
      <div class="nav__drop nav__drop--more">
        <a href="/empieza-aqui/" class:list={['nav__more', { 'is-active': masActive }]} aria-haspopup="true">Más <Icon name="chevron-down" size={16} /></a>
        <div class="mega mega--sm">
          {mas.map((m) => (<a href={m.href} aria-current={is(m.href) ? 'page' : undefined}><Icon name={m.icon} size={18} /> {m.label}</a>))}
        </div>
      </div>
    </nav>
    <div class="bar__end">
      <button class="iconbtn theme-btn" id="theme-toggle" type="button" aria-label="Activar modo oscuro" title="Modo claro / oscuro"><span class="t-moon"><Icon name="moon" size={20} /></span><span class="t-sun"><Icon name="sun" size={20} /></span></button>
      <a href="/playbook/" class="btn btn--playbook btn--sm now"><Icon name="siren" size={16} /> ¿Pasa ahora?</a>
      <button class="iconbtn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Abrir menú">
        <span class="menu-icon menu-icon--open"><Icon name="menu" size={24} /></span>
        <span class="menu-icon menu-icon--close"><Icon name="x" size={24} /></span>
      </button>
    </div>
  </div>
</header>
<nav class="nav nav--drawer" id="nav" aria-label="Principal" aria-hidden="true" inert>
  <a href={CALC} class="d-calc"><Icon name="calculator" size={22} /> <span><strong>Calculadora</strong><small>Tu lista de la compra en 30 segundos</small></span></a>
  <details class="d-acc" open={is('/preparate')}>
    <summary><span>Prepárate</span><Icon name="chevron-down" size={20} /></summary>
    <div class="d-list">
      <a href="/preparate/">Ver todas las áreas</a>
      {CATEGORIAS.map((c) => (<a href={`/preparate/${c.id}/`}><Icon name={c.icon} size={18} /> {c.nombre}</a>))}
      <a href="/preparate/prepper/">Nivel Prepper</a>
    </div>
  </details>
  <a href="/playbook/" class="d-list-top" aria-current={is('/playbook') ? 'page' : undefined}><Icon name="siren" size={18} /> The Playbook</a>
  <details class="d-acc" open={masActive}>
    <summary><span>Más</span><Icon name="chevron-down" size={20} /></summary>
    <div class="d-list">
      {mas.map((m) => (<a href={m.href}><Icon name={m.icon} size={18} /> {m.label}</a>))}
    </div>
  </details>
  <a href="/playbook/" class="d-sos"><Icon name="siren" size={20} /> ¿Está pasando ahora?</a>
</nav>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('nav');

  function setOpen(open: boolean) {
    nav?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.documentElement.classList.toggle('nav-open', open);
    document.body.classList.toggle('nav-open', open);
    if (open) {
      const y = window.scrollY;
      document.body.dataset.scrollY = String(y);
      document.body.style.top = `-${y}px`;
      nav?.removeAttribute('aria-hidden');
      nav?.removeAttribute('inert');
    } else {
      const y = parseInt(document.body.dataset.scrollY || '0', 10);
      document.body.style.top = '';
      delete document.body.dataset.scrollY;
      window.scrollTo(0, y);
      nav?.setAttribute('aria-hidden', 'true');
      nav?.setAttribute('inert', '');
    }
  }

  btn?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) setOpen(false);
  });
  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 1101px)').matches && nav?.classList.contains('open')) setOpen(false);
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const d = document.documentElement;
    const dark = d.dataset.theme !== 'dark';
    d.dataset.theme = dark ? 'dark' : 'light';
    try { localStorage.setItem('mr-theme', dark ? 'dark' : 'light'); } catch {}
    syncThemeBtn();
  });
  function syncThemeBtn() {
    const b = document.getElementById('theme-toggle');
    const dark = document.documentElement.dataset.theme === 'dark';
    b?.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');
    b?.setAttribute('aria-pressed', String(dark));
  }
  syncThemeBtn();
</script>
<style>

  header.site{position:sticky;top:0;z-index:var(--z-header);background:color-mix(in srgb,var(--color-bg) 88%,transparent);border-bottom:1px solid var(--color-border);overflow:visible}
  header.site::before{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px)}
  .bar{display:flex;align-items:center;gap:var(--space-4);height:var(--header-height);overflow:visible;position:relative;z-index:1;min-width:0}
  .logo{flex:none;display:flex;align-items:center;line-height:0;overflow:visible}
  .logo img{display:block;height:40px;width:auto}
  .logo .logo-dark{display:none}
  .t-moon{display:inline-flex}
  .t-sun{display:none}
  :global(:root[data-theme='dark']) .t-sun{display:inline-flex}
  :global(:root[data-theme='dark']) .t-moon{display:none}
  :global(:root[data-theme='dark']) .logo .logo-dark{display:block}
  :global(:root[data-theme='dark']) .logo .logo-light{display:none}
  .nav{display:flex;align-items:center;gap:2px;margin-left:var(--space-2);flex-wrap:nowrap;min-width:0}
  .nav--drawer{display:none}
  .nav > a,.nav__drop > a{display:inline-flex;align-items:center;gap:.35em;padding:.55em .7em;border-radius:var(--radius-pill);text-decoration:none;color:var(--color-text);font-weight:600;font-size:var(--size-sm);white-space:nowrap}
  .nav > a:hover,.nav__drop > a:hover{background:var(--color-bg-subtle);color:var(--color-heading)}
  .nav a[aria-current='page'],.nav__more.is-active{color:var(--color-heading);background:var(--color-secondary-soft)}
  .nav__pb{color:var(--color-playbook-text)!important;background:var(--color-playbook-bg)}
  .nav__pb[aria-current='page']{background:var(--color-playbook)!important;color:var(--color-on-playbook)!important}
  .nav > .nav__calc{background:var(--color-primary);color:var(--color-on-primary);margin-inline:var(--space-2)}
  .nav > .nav__calc:hover{background:var(--color-primary);color:var(--color-on-primary);filter:brightness(1.12)}
  .nav > .nav__calc[aria-current='page']{outline:2px solid var(--color-secondary);outline-offset:2px;background:var(--color-primary);color:var(--color-on-primary)}
  .nav__drop{position:relative}
  .mega{position:absolute;top:100%;left:-1rem;width:min(560px,92vw);padding:var(--space-4);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);opacity:0;visibility:hidden;transform:translateY(6px);transition:opacity var(--motion-base) var(--motion-ease),transform var(--motion-base) var(--motion-ease),visibility var(--motion-base);box-sizing:border-box;max-width:calc(100vw - 2rem)}
  .mega--sm{width:min(300px,92vw);left:auto;right:0;display:flex;flex-direction:column;gap:2px}
  .nav__drop:hover .mega,.nav__drop:focus-within .mega{opacity:1;visibility:visible;transform:none}
  .mega__grid{display:grid;grid-template-columns:1fr 1fr;gap:2px}
  .mega a{display:flex;gap:.6em;align-items:center;padding:.55em .75em;border-radius:var(--radius-sm);text-decoration:none;color:var(--color-text);font-size:var(--size-sm);min-width:0}
  .mega a:hover{background:var(--color-bg-subtle);color:var(--color-heading)}
  .mega :global(.icon){color:var(--color-secondary);flex:none}
  .mega__foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);margin-top:var(--space-3);padding-top:var(--space-3);border-top:1px solid var(--color-border);font-size:var(--size-sm);min-width:0}
  .bar__end{margin-left:auto;display:flex;align-items:center;gap:var(--space-2);flex:none}
  .now{white-space:nowrap}
  .iconbtn{background:none;border:0;color:var(--color-text);padding:.5rem;border-radius:var(--radius-pill);cursor:pointer;display:inline-grid;place-items:center;min-width:44px;min-height:44px}
  .iconbtn:hover{background:var(--color-bg-subtle)}
  .menu-btn{display:none}
  .menu-icon--close{display:none}
  @media (max-width:1400px){ .now{display:none} }
  @media (max-width:1100px){
    .menu-btn{display:inline-grid}
    .nav--desktop{display:none}
    .nav--drawer{position:fixed;top:var(--header-height);left:0;right:0;bottom:0;z-index:var(--z-overlay);flex-direction:column;align-items:stretch;gap:0;margin:0;padding:var(--space-4) var(--gutter) max(var(--space-12),env(safe-area-inset-bottom,0px));background:var(--color-bg);overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;display:none;height:calc(100vh - var(--header-height));height:calc(100dvh - var(--header-height));width:100%;box-sizing:border-box}
    .nav--drawer.open{display:flex}
    .nav--drawer .d-calc{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-4);margin-bottom:var(--space-3);border-radius:var(--radius-lg);background:var(--color-primary);color:var(--color-on-primary);text-decoration:none;min-height:56px;min-width:0}
    .nav--drawer .d-calc small{display:block;opacity:.85;font-size:var(--size-xs)}
    .nav--drawer .d-calc strong{font-size:var(--size-lg);overflow-wrap:anywhere}
    .d-acc{border-bottom:1px solid var(--color-border)}
    .d-acc summary{display:flex;justify-content:space-between;align-items:center;padding:1em .5em;font-size:var(--size-lg);font-weight:650;cursor:pointer;list-style:none;min-height:52px;-webkit-tap-highlight-color:transparent;color:var(--color-heading)}
    .d-acc summary::-webkit-details-marker{display:none}
    .d-acc[open] summary :global(.icon){transform:rotate(180deg)}
    .d-list{display:flex;flex-direction:column;padding:0 0 var(--space-3)}
    .d-list a{display:flex;align-items:center;gap:.7em;padding:.8em .5em;text-decoration:none;color:var(--color-text);font-size:var(--size-base);min-height:46px;min-width:0}
    .d-list a:active{background:var(--color-bg-subtle)}
    .d-list :global(.icon){color:var(--color-secondary);flex:none}
    .nav--drawer .d-sos{display:flex;align-items:center;justify-content:center;gap:.6em;margin-top:var(--space-5);padding:var(--space-4);border-radius:var(--radius-md);background:var(--color-playbook-bg);color:var(--color-playbook-text);font-weight:650;text-decoration:none;min-height:52px}
    .logo img{height:32px}
  }
  :global(body.nav-open) .menu-icon--open{display:none}
  :global(body.nav-open) .menu-icon--close{display:inline-grid}
  :global(html.nav-open),:global(body.nav-open){overflow:hidden;overscroll-behavior:none}
  :global(body.nav-open){position:fixed;width:100%;left:0;right:0}
  :global(body.nav-open) header.site{z-index:var(--z-modal);background:var(--color-bg)}

  .nav--drawer > .d-list-top{display:flex;align-items:center;gap:.7em;padding:1em .5em;font-size:var(--size-lg);font-weight:650;text-decoration:none;color:var(--color-heading);border-bottom:1px solid var(--color-border);min-height:52px}
</style>
