---
import Icon from './Icon.astro';
import { CATEGORIAS } from '../data/categorias';
const path = Astro.url.pathname;
const is = (p: string) => path.startsWith(p);
---
<header class="site">
  <div class="container container--wide bar">
    <a href="/" class="logo" aria-label="Modo Refugio, inicio">
      <img src="/brand/logo-horizontal.svg" alt="Modo Refugio" width="138" height="44" class="logo-light" />
      <img src="/brand/logo-horizontal-dark.svg" alt="" width="138" height="44" class="logo-dark" aria-hidden="true" />
    </a>
    <nav class="nav" aria-label="Principal" id="nav">
      <a href="/playbook/" class="nav__pb" aria-current={is('/playbook') ? 'page' : undefined}><Icon name="siren" size={18} /> The Playbook</a>
      <div class="nav__drop">
        <a href="/preparate/" aria-current={is('/preparate') ? 'page' : undefined}>Prepárate <Icon name="chevron-down" size={16} /></a>
        <div class="mega">
          <div class="mega__grid">
            {CATEGORIAS.map((c) => (
              <a href={`/preparate/${c.id}/`}><Icon name={c.icon} size={18} /> {c.nombre}</a>
            ))}
          </div>
          <div class="mega__foot">
            <a href="/preparate/#por-riesgo">Prepárate por riesgo →</a>
            <span><span class="badge badge--basic">Básico</span> <span class="badge badge--advanced">Avanzado</span></span>
          </div>
        </div>
      </div>
      <a href="/empieza-aqui/" aria-current={is('/empieza-aqui') ? 'page' : undefined}>Empieza aquí</a>
      <a href="/equipo/" aria-current={is('/equipo') ? 'page' : undefined}>Equipo</a>
      <a href="/herramientas/" aria-current={is('/herramientas') ? 'page' : undefined}>Herramientas</a>
      <a href="/descargas/" class="nav__dl" aria-current={is('/descargas') ? 'page' : undefined}><Icon name="download" size={16} /> PDFs</a>
    </nav>
    <div class="bar__end">
      <button class="iconbtn theme-btn" id="theme-toggle" type="button" aria-label="Activar modo oscuro" title="Modo claro / oscuro"><span class="t-moon"><Icon name="moon" size={20} /></span><span class="t-sun"><Icon name="sun" size={20} /></span></button>
      <a href="/playbook/" class="btn btn--playbook btn--sm now"><Icon name="siren" size={16} /> ¿Está pasando ahora?</a>
      <button class="iconbtn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Abrir menú"><Icon name="menu" size={24} /></button>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
    document.body.classList.toggle('nav-open', !!open);
  });
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const d = document.documentElement;
    const dark = d.dataset.theme !== 'dark';
    d.dataset.theme = dark ? 'dark' : 'light';
    try { localStorage.setItem('mr-theme', dark ? 'dark' : 'light'); } catch {}
    syncThemeBtn();
  });
  function syncThemeBtn() {
    const b = document.getElementById('theme-toggle');
    const dark = document.documentElement.dataset.theme === 'dark';
    b?.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');
    b?.setAttribute('aria-pressed', String(dark));
  }
  syncThemeBtn();
</script>
<style>
  header.site{position:sticky;top:0;z-index:var(--z-header);background:color-mix(in srgb,var(--color-bg) 88%,transparent);backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid var(--color-border)}
  .bar{display:flex;align-items:center;gap:var(--space-6);height:var(--header-height)}
  .logo{flex:none;display:block}
  .logo img{height:44px;width:auto}
  .logo-dark{display:none}
  .t-moon{display:inline-flex}
  .t-sun{display:none}
  :global(:root[data-theme='dark']) .t-sun{display:inline-flex}
  :global(:root[data-theme='dark']) .t-moon{display:none}
  :global(:root[data-theme='dark']) .logo-dark{display:block}
  :global(:root[data-theme='dark']) .logo-light{display:none}
  .nav{display:flex;align-items:center;gap:var(--space-1);margin-left:var(--space-4)}
  .nav > a,.nav__drop > a{display:inline-flex;align-items:center;gap:.35em;padding:.55em .8em;border-radius:var(--radius-pill);text-decoration:none;color:var(--color-text);font-weight:550;font-size:var(--size-sm)}
  .nav > a:hover,.nav__drop > a:hover{background:var(--color-bg-subtle);color:var(--color-heading)}
  .nav a[aria-current='page']{color:var(--color-heading);background:var(--color-secondary-soft)}
  .nav__pb{color:var(--color-playbook-text)!important;background:var(--color-playbook-bg)}
  .nav__pb[aria-current='page']{background:var(--color-playbook)!important;color:var(--color-on-playbook)!important}
  .nav__drop{position:relative}
  .mega{position:absolute;top:100%;left:-1rem;width:560px;padding:var(--space-4);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);opacity:0;visibility:hidden;transform:translateY(6px);transition:all var(--motion-base) var(--motion-ease)}
  .nav__drop:hover .mega,.nav__drop:focus-within .mega{opacity:1;visibility:visible;transform:none}
  .mega__grid{display:grid;grid-template-columns:1fr 1fr;gap:2px}
  .mega__grid a{display:flex;gap:.6em;align-items:center;padding:.6em .75em;border-radius:var(--radius-sm);text-decoration:none;color:var(--color-text);font-size:var(--size-sm)}
  .mega__grid a:hover{background:var(--color-bg-subtle);color:var(--color-heading)}
  .mega__grid :global(.icon){color:var(--color-secondary)}
  .mega__foot{display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-3);padding-top:var(--space-3);border-top:1px solid var(--color-border);font-size:var(--size-sm)}
  .bar__end{margin-left:auto;display:flex;align-items:center;gap:var(--space-2)}
  .iconbtn{background:none;border:0;color:var(--color-text);padding:.5rem;border-radius:var(--radius-pill);cursor:pointer;display:inline-grid;place-items:center}
  .iconbtn:hover{background:var(--color-bg-subtle)}
  .menu-btn{display:none}
  @media (max-width:1180px){ .now{display:none} }
  @media (max-width:980px){
    .menu-btn{display:inline-grid}
    .nav{position:fixed;inset:var(--header-height) 0 0 0;flex-direction:column;align-items:stretch;gap:0;margin:0;padding:var(--space-4) var(--gutter) var(--space-12);background:var(--color-bg);overflow-y:auto;display:none}
    .nav.open{display:flex}
    .nav > a,.nav__drop > a{font-size:var(--size-lg);padding:.9em .5em;border-radius:0;border-bottom:1px solid var(--color-border)}
    .nav__pb{border-radius:var(--radius-md)!important;justify-content:center;margin-bottom:var(--space-3)}
    .mega{position:static;width:auto;opacity:1;visibility:visible;transform:none;box-shadow:none;border:0;padding:var(--space-2) 0;background:transparent}
    .mega__foot{display:none}
    .logo img{height:36px}
  }
  :global(body.nav-open){overflow:hidden}
</style>
