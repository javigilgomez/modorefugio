---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; description: string; href: string; updated?: string }
const { title, description, href, updated = '22 de noviembre de 2026' } = Astro.props;
const crumbs = [{ name: title, href }];
---
<Base title={title} description={description} crumbs={crumbs}>
  <article class="container container--narrow section--tight">
    <Breadcrumbs items={crumbs} />
    <h1>{title}</h1>
    <p class="muted small">Última actualización: {updated}</p>
    <div class="prose"><slot /></div>
  </article>
</Base>
