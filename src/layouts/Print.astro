---
import '../styles/tokens.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · Modo Refugio (versión imprimible)</title>
  <style is:global>
    @font-face{font-family:'Bricolage Grotesque';font-weight:200 800;src:url('/fonts/BricolageGrotesque-Variable.woff2') format('woff2');}
    @font-face{font-family:'Inter';font-weight:100 900;src:url('/fonts/Inter-Variable.woff2') format('woff2');}
    @font-face{font-family:'Special Elite';font-weight:400;src:url('/fonts/SpecialElite-Regular.woff2') format('woff2');}
    @page{size:A4;margin:14mm 13mm 16mm}
    *{box-sizing:border-box}
    html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    body{margin:0;font:10.2pt/1.42 var(--font-body);color:#1C2421;background:#fff}
    h1,h2,h3{font-family:var(--font-heading);color:#14352F;margin:0;line-height:1.15;letter-spacing:-.01em}
    .sheet{max-width:184mm;margin:0 auto}
    @media screen{body{background:#e9e4d8}.sheet{background:#fff;padding:14mm;margin:20px auto;box-shadow:0 4px 24px rgba(0,0,0,.15)}}
    ul{margin:0;padding:0;list-style:none}
    a{color:inherit;text-decoration:none}
  </style>
</head>
<body><div class="sheet"><slot /></div></body>
</html>
